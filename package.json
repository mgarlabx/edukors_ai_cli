{
  "name": "@edukors/ai-cli",
  "version": "0.1.0",
  "description": "Shared integration between EDUKORS editors and installed AI provider CLIs: accounts, sessions, tools and normalized events.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgarlabx/edukors_ai_cli.git"
  },
  "homepage": "https://github.com/mgarlabx/edukors_ai_cli#readme",
  "bugs": {
    "url": "https://github.com/mgarlabx/edukors_ai_cli/issues"
  },
  "keywords": [
    "edukors",
    "claude",
    "codex",
    "ai",
    "cli",
    "agent",
    "mcp"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./host": {
      "types": "./dist/host/stdio.d.ts",
      "import": "./dist/host/stdio.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "bin": {
    "edukors-ai": "./dist/cli/main.js",
    "edukors-ai-host": "./dist/host/main.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "npm run build --silent && node dist/cli/main.js",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
